  "cards": [
    {
      "dot": "violet",
      "title": "大模型做什么",
      "items": [
        "主协调者根据需求和反馈决定下一步，提出分派或完成申请。",
        "专家生成修改内容、测试步骤、断言期望值和工具参数。",
        "模型的判断与总结属于建议，工具调用由后端实际执行。"
      ]
    },
    {
      "dot": "cyan",
      "title": "后端程序做什么",
      "items": [
        "计算 hash、判断证据是否有效、列出缺项、累计重复失败。",
        "执行器属于程序侧：真实运行脚本、构建网页和操作浏览器。",
        "后端保存报告并核对交付门槛，模型不能自行写入通过状态。"
      ]
    },
    {
      "dot": "amber",
      "title": "提案与源码的关系",
      "items": [
        "本图展示拟实现流程，尚未编码或上线。",
        "源码引用标注现有职责和拟改造入口，不表示新增行为已存在。"
      ]
    },
    {
      "dot": "cyan",
      "title": "证据按依赖复用",
      "items": [
        "网页检查依赖入口及实际引用的脚本、样式和资源。",
        "与网页无关的 PPTX 变化不影响该网页证据。",
        "动态脚本依赖不明确时保守使用全输入，并解释原因。"
      ]
    },
    {
      "dot": "rose",
      "title": "有界恢复",
      "items": [
        "只换交付总结、报告编号或展示顺序，不重置同一失败。",
        "补齐一个缺项，只解决该项，不清空其他未解决问题。",
        "旧证据信息不足时有针对性补验，保留原始记录。"
      ]
    }
  ]
