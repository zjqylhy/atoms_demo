  "cards": [
    {
      "dot": "emerald",
      "title": "已确认的共享范围",
      "items": [
        "所有登录账号均可查看、修改、发 AI 指令和删除全部项目。",
        "旧游客项目直接进入共享列表；创建者不再决定访问权限。"
      ]
    },
    {
      "dot": "rose",
      "title": "新增的登录边界",
      "items": [
        "前端检查与服务端校验同时生效；无 Cookie 或游客 Cookie 都不能使用业务接口。",
        "公开介绍和公开分享继续可见；保存副本前需要登录。",
        "登录失败停留表单；网络错误可重试；成功登录不会自动发出 AI 指令。"
      ]
    },
    {
      "dot": "amber",
      "title": "额度和并发",
      "items": [
        "AI 运行额度计入发起账号，文件保留原存储位置。",
        "同项目只允许一个活动运行；应用数据继续检查修订冲突。",
        "此图描述待确认方案，不代表当前服务已具备这些行为。"
      ]
    }
